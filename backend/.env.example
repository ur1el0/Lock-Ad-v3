# Django application settings. Single-quote values containing '$' so Compose
# passes them literally when this file is supplied with --env-file.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8003,http://127.0.0.1:8003,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,https://localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8003,http://127.0.0.1:8003,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,https://localhost
DJANGO_SECURE_COOKIES=False
DJANGO_TRUST_X_FORWARDED_PROTO=False
PUBLIC_DOMAIN=localhost

# PostgreSQL settings used by Docker Compose
POSTGRES_DB=lockad_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Leave blank to disable automatic incident-photo deletion.
INCIDENT_IMAGE_RETENTION_DAYS=

# Optional provider keys
OPENROUTESERVICE_API_KEY=
GEMINI_API_KEY=

# Explicit opt-in after reviewing provider terms, intended audience, and data handling.
GEMINI_API_ENABLED=False
GEMINI_INCIDENT_IMAGE_ANALYSIS_ENABLED=False
